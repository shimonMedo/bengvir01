{
  "name": "bengvir01",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env.local server/index.js",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env.local server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "express": "^5.2.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
